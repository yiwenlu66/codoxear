#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/codoxear-docker-sandbox [build|smoke|start|stop|logs|test]

Runs Codoxear in an isolated Docker validation sandbox.

Defaults:
  CODOXEAR_DOCKER_PORT      18790
  CODOXEAR_DOCKER_NAME      codoxear-sandbox-${CODOXEAR_DOCKER_PORT}
  CODOXEAR_DOCKER_IMAGE     codoxear-sandbox:latest
  CODOXEAR_DOCKER_ROOT      /tmp/codoxear-docker-sandbox-${CODOXEAR_DOCKER_PORT}
  CODOXEAR_DOCKER_PASSWORD  test-password

The sandbox intentionally uses HOME inside the mounted CODOXEAR_DOCKER_ROOT so
~/.local/share/codoxear, backend homes, sockets, and logs stay out of the host
live runtime. Backend credentials are not copied by this script.
USAGE
}

cmd="${1:-smoke}"
case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
esac

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
port="${CODOXEAR_DOCKER_PORT:-18790}"
name="${CODOXEAR_DOCKER_NAME:-codoxear-sandbox-${port}}"
image="${CODOXEAR_DOCKER_IMAGE:-codoxear-sandbox:latest}"
root="${CODOXEAR_DOCKER_ROOT:-/tmp/codoxear-docker-sandbox-${port}}"
password="${CODOXEAR_DOCKER_PASSWORD:-test-password}"
artifacts="$root/artifacts"
home_dir="$root/home"

ensure_safe_port() {
  if [[ "$port" == "8743" ]]; then
    echo "refusing to use default live Codoxear port 8743" >&2
    exit 2
  fi
}

build_image() {
  docker build -f "$repo_root/docker/sandbox.Dockerfile" -t "$image" "$repo_root"
}

prepare_root() {
  mkdir -p "$artifacts" "$home_dir/.local/share" "$home_dir/.codex" "$home_dir/.pi/agent"
}

stop_container() {
  docker rm -f "$name" >/dev/null 2>&1 || true
}

start_container() {
  ensure_safe_port
  prepare_root
  build_image
  stop_container
  docker run -d --rm \
    --name "$name" \
    -p "127.0.0.1:${port}:${port}" \
    -e HOME=/home/tester \
    -e CODEX_WEB_PASSWORD="$password" \
    -e CODEX_WEB_HOST=0.0.0.0 \
    -e CODEX_WEB_PORT="$port" \
    -e PYTHONPATH=/workspace \
    -e PYTHONDONTWRITEBYTECODE=1 \
    -v "$repo_root":/workspace:ro \
    -v "$home_dir":/home/tester \
    -w /workspace \
    "$image" \
    python3 -m codoxear.server >/dev/null
  echo "container=$name"
  echo "url=http://127.0.0.1:${port}/"
  echo "root=$root"
}

wait_for_http() {
  local url="http://127.0.0.1:${port}/api/me"
  for _ in $(seq 1 80); do
    if curl -fsS -o /dev/null "$url" >/dev/null 2>&1; then
      return 0
    fi
    local code
    code="$(curl -sS -o /dev/null -w '%{http_code}' "$url" 2>/dev/null || true)"
    if [[ "$code" == "401" ]]; then
      return 0
    fi
    sleep 0.25
  done
  echo "server did not become reachable at $url" >&2
  docker logs "$name" >&2 || true
  return 1
}

smoke() {
  start_container
  wait_for_http
  local jar="$artifacts/cookies.txt"
  local me_code sessions_code app_dir
  me_code="$(curl -sS -o "$artifacts/me.before-login.json" -w '%{http_code}' "http://127.0.0.1:${port}/api/me")"
  curl -sS -c "$jar" \
    -H 'Content-Type: application/json' \
    -d "{\"password\":\"${password}\"}" \
    "http://127.0.0.1:${port}/api/login" > "$artifacts/login.json"
  sessions_code="$(curl -sS -b "$jar" -o "$artifacts/sessions.json" -w '%{http_code}' "http://127.0.0.1:${port}/api/sessions")"
  app_dir="$(docker exec -w /workspace "$name" python3 -c 'from codoxear import server; print(server.APP_DIR)')"
  docker exec "$name" sh -lc 'printf "HOME=%s\n" "$HOME"; ls -la "$HOME/.local/share"; ls -la "$HOME/.local/share/codoxear" 2>/dev/null || true' > "$artifacts/isolation.txt"
  docker logs "$name" > "$artifacts/server.log" 2>&1 || true
  printf 'pre_login_api_me_status=%s\n' "$me_code"
  printf 'post_login_sessions_status=%s\n' "$sessions_code"
  printf 'container_app_dir=%s\n' "$app_dir"
  printf 'artifacts=%s\n' "$artifacts"
  if [[ "$me_code" != "401" ]]; then
    echo "expected /api/me before login to return 401, got $me_code" >&2
    return 1
  fi
  if [[ "$sessions_code" != "200" ]]; then
    echo "expected /api/sessions after login to return 200, got $sessions_code" >&2
    return 1
  fi
  case "$app_dir" in
    /home/tester/.local/share/codoxear) ;;
    *) echo "unexpected APP_DIR: $app_dir" >&2; return 1 ;;
  esac
}

unit_tests() {
  ensure_safe_port
  prepare_root
  build_image
  docker run --rm \
    -e HOME=/home/tester \
    -e CODEX_WEB_PASSWORD=test-password \
    -e PYTHONPATH=/workspace \
    -e PYTHONDONTWRITEBYTECODE=1 \
    -v "$repo_root":/workspace:ro \
    -v "$home_dir":/home/tester \
    -w /workspace \
    "$image" \
    python3 -m pytest -q -o cache_dir=/tmp/codoxear-pytest-cache "$@"
}

case "$cmd" in
  build) build_image ;;
  start) start_container ;;
  smoke) smoke ;;
  stop) stop_container ;;
  logs) docker logs "$name" ;;
  test) shift; unit_tests "$@" ;;
  *) usage >&2; exit 2 ;;
esac
