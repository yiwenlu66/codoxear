#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/codoxear-docker-sandbox [build|smoke|start|stop|logs|preflight|test]

Runs Codoxear in an isolated Docker validation sandbox.

Defaults:
  CODOXEAR_DOCKER_PORT      18790
  CODOXEAR_DOCKER_NAME      codoxear-sandbox-${CODOXEAR_DOCKER_PORT}
  CODOXEAR_DOCKER_IMAGE     codoxear-sandbox:latest
  CODOXEAR_DOCKER_ROOT      /tmp/codoxear-docker-sandbox-${CODOXEAR_DOCKER_PORT}
  CODOXEAR_DOCKER_PASSWORD  test-password

The sandbox intentionally uses HOME inside the mounted CODOXEAR_DOCKER_ROOT so
~/.local/share/codoxear, backend homes, sockets, and logs stay out of the host
live runtime. Backend credentials are not copied by this script.

Isolation guard (preflight) refuses to start if CODOXEAR_DOCKER_ROOT or the
throwaway home would alias, sit inside, or contain the host live runtime
(~/.local/share/codoxear or legacy ~/.local/share/codex-web), or if host env
CODEXEAR_APP_DIR / CODEX_WEB_APP_DIR points at the live runtime. The container
is launched without forwarding either app-dir variable so APP_DIR always
resolves under the throwaway container HOME. Run 'preflight' to check without
starting Docker.
USAGE
}

cmd="${1:-smoke}"
case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
esac

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
port="${CODOXEAR_DOCKER_PORT:-18790}"
name="${CODOXEAR_DOCKER_NAME:-codoxear-sandbox-${port}}"
image="${CODOXEAR_DOCKER_IMAGE:-codoxear-sandbox:latest}"
root="${CODOXEAR_DOCKER_ROOT:-/tmp/codoxear-docker-sandbox-${port}}"
password="${CODOXEAR_DOCKER_PASSWORD:-test-password}"
artifacts="$root/artifacts"
home_dir="$root/home"

ensure_safe_port() {
  if [[ "$port" == "8743" ]]; then
    echo "refusing to use default live Codoxear port 8743" >&2
    exit 2
  fi
}

_realpath() {
  # Portable absolute path without touching the target's contents. Resolves
  # the existing ancestor via cd+pwd; never cds into the live runtime dirs.
  local p="$1"
  if [[ -d "$p" ]]; then
    ( cd "$p" && pwd ) 2>/dev/null || printf '%s\n' "$p"
  else
    local parent child
    parent="$(dirname "$p")"
    child="$(basename "$p")"
    if [[ -d "$parent" ]]; then
      ( cd "$parent" && printf '%s/%s\n' "$(pwd)" "$child" ) 2>/dev/null || printf '%s\n' "$p"
    else
      printf '%s\n' "$p"
    fi
  fi
}

_is_within() {
  # 0 if $1 equals $2 or is nested below $2 (string prefix on normalized paths).
  local candidate="$1" base="$2"
  [[ "$candidate" == "$base" || "$candidate" == "$base/"* ]]
}

ensure_isolation() {
  # Refuse to run if the sandbox throwaway home/root could reach the host live
  # runtime state. This is the guard that prevents dev/cert verification from
  # contaminating ~/.local/share/codoxear (the incident root cause).
  local live_home live_app live_legacy_app
  live_home="$(_realpath "$HOME")"
  live_app="$live_home/.local/share/codoxear"
  live_legacy_app="$live_home/.local/share/codex-web"

  local real_root real_home_dir
  real_root="$(_realpath "$root")"
  real_home_dir="$(_realpath "$home_dir")"

  local offenders=""
  local candidate live_path
  for candidate in "$real_root" "$real_home_dir"; do
    if [[ "$candidate" == "$live_home" ]]; then
      offenders+="  - $candidate equals host HOME ($live_home)\n"
    fi
    for live_path in "$live_app" "$live_legacy_app"; do
      if _is_within "$candidate" "$live_path"; then
        offenders+="  - $candidate is inside live app dir ($live_path)\n"
      elif _is_within "$live_path" "$candidate"; then
        offenders+="  - $candidate contains live app dir ($live_path)\n"
      fi
    done
  done

  # Defensive: even though this script never forwards these into the container,
  # refuse if a host environment override points at the live runtime, so a future
  # edit adding '-e CODEX*_APP_DIR' cannot silently reintroduce contamination.
  local env_var env_val real_env
  for env_var in CODEXEAR_APP_DIR CODEX_WEB_APP_DIR; do
    env_val="${!env_var:-}"
    if [[ -n "$env_val" ]]; then
      real_env="$(_realpath "$env_val")"
      if _is_within "$real_env" "$live_home" || _is_within "$live_app" "$real_env" || _is_within "$live_legacy_app" "$real_env"; then
        offenders+="  - \$$env_var=$env_val resolves at/under host live runtime\n"
      fi
    fi
  done

  if [[ -n "$offenders" ]]; then
    cat >&2 <<EOF
refusing to start sandbox: isolation guard failed:
$(printf '%b' "$offenders")
Host live runtime: $live_app (legacy: $live_legacy_app)
Set CODOXEAR_DOCKER_ROOT to a throwaway path outside the host live runtime and
unset CODEXEAR_APP_DIR / CODEX_WEB_APP_DIR (or point them at a throwaway path).
EOF
    exit 2
  fi
}

build_image() {
  docker build -f "$repo_root/docker/sandbox.Dockerfile" -t "$image" "$repo_root"
}

prepare_root() {
  mkdir -p "$artifacts" "$home_dir/.local/share" "$home_dir/.codex" "$home_dir/.pi/agent"
}

stop_container() {
  docker rm -f "$name" >/dev/null 2>&1 || true
}

start_container() {
  ensure_safe_port
  ensure_isolation
  prepare_root
  build_image
  stop_container
  docker run -d --rm \
    --name "$name" \
    -p "127.0.0.1:${port}:${port}" \
    -e HOME=/home/tester \
    -e CODEX_WEB_PASSWORD="$password" \
    -e CODEX_WEB_HOST=0.0.0.0 \
    -e CODEX_WEB_PORT="$port" \
    -e PYTHONPATH=/workspace \
    -e PYTHONDONTWRITEBYTECODE=1 \
    -v "$repo_root":/workspace:ro \
    -v "$home_dir":/home/tester \
    -w /workspace \
    "$image" \
    python3 -m codoxear.server >/dev/null
  echo "container=$name"
  echo "url=http://127.0.0.1:${port}/"
  echo "root=$root"
}

wait_for_http() {
  local url="http://127.0.0.1:${port}/api/me"
  for _ in $(seq 1 80); do
    if curl -fsS -o /dev/null "$url" >/dev/null 2>&1; then
      return 0
    fi
    local code
    code="$(curl -sS -o /dev/null -w '%{http_code}' "$url" 2>/dev/null || true)"
    if [[ "$code" == "401" ]]; then
      return 0
    fi
    sleep 0.25
  done
  echo "server did not become reachable at $url" >&2
  docker logs "$name" >&2 || true
  return 1
}

smoke() {
  start_container
  wait_for_http
  local jar="$artifacts/cookies.txt"
  local me_code sessions_code app_dir
  me_code="$(curl -sS -o "$artifacts/me.before-login.json" -w '%{http_code}' "http://127.0.0.1:${port}/api/me")"
  curl -sS -c "$jar" \
    -H 'Content-Type: application/json' \
    -d "{\"password\":\"${password}\"}" \
    "http://127.0.0.1:${port}/api/login" > "$artifacts/login.json"
  sessions_code="$(curl -sS -b "$jar" -o "$artifacts/sessions.json" -w '%{http_code}' "http://127.0.0.1:${port}/api/sessions")"
  app_dir="$(docker exec -w /workspace "$name" python3 -c 'from codoxear import server; print(server.APP_DIR)')"
  docker exec "$name" sh -lc 'printf "HOME=%s\n" "$HOME"; ls -la "$HOME/.local/share"; ls -la "$HOME/.local/share/codoxear" 2>/dev/null || true' > "$artifacts/isolation.txt"
  docker logs "$name" > "$artifacts/server.log" 2>&1 || true
  printf 'pre_login_api_me_status=%s\n' "$me_code"
  printf 'post_login_sessions_status=%s\n' "$sessions_code"
  printf 'container_app_dir=%s\n' "$app_dir"
  printf 'artifacts=%s\n' "$artifacts"
  if [[ "$me_code" != "401" ]]; then
    echo "expected /api/me before login to return 401, got $me_code" >&2
    return 1
  fi
  if [[ "$sessions_code" != "200" ]]; then
    echo "expected /api/sessions after login to return 200, got $sessions_code" >&2
    return 1
  fi
  case "$app_dir" in
    /home/tester/.local/share/codoxear) ;;
    *) echo "unexpected APP_DIR: $app_dir" >&2; return 1 ;;
  esac
}

unit_tests() {
  ensure_safe_port
  ensure_isolation
  prepare_root
  build_image
  docker run --rm \
    -e HOME=/home/tester \
    -e CODEX_WEB_PASSWORD=test-password \
    -e PYTHONPATH=/workspace \
    -e PYTHONDONTWRITEBYTECODE=1 \
    -v "$repo_root":/workspace:ro \
    -v "$home_dir":/home/tester \
    -w /workspace \
    "$image" \
    python3 -m pytest -q -o cache_dir=/tmp/codoxear-pytest-cache "$@"
}

case "$cmd" in
  build) build_image ;;
  start) start_container ;;
  smoke) smoke ;;
  stop) stop_container ;;
  logs) docker logs "$name" ;;
  preflight) ensure_safe_port; ensure_isolation; echo "preflight ok: root=$root home=$home_dir" ;;
  test) shift; unit_tests "$@" ;;
  *) usage >&2; exit 2 ;;
esac
